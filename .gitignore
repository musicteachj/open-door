# --- Secrets and local config ---------------------------------------------
# Real keys live in .env files that never leave the machine. .env.example is
# the committed contract listing every variable.
.env
.env.*
!.env.example
# The development encryption keyring that `make keyring` writes.
apps/api/.keys/

# --- Python (apps/api) -----------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# --- Node (apps/web) -------------------------------------------------------
node_modules/
dist/
dist-e2e/
*.tsbuildinfo
.vite/
coverage/

# --- Playwright ------------------------------------------------------------
playwright-report/
test-results/
blob-report/
playwright/.cache/

# --- Captures --------------------------------------------------------------
# `make captures` writes the design-beside-build report and its pictures here.
apps/web/captures/

# --- Evals -----------------------------------------------------------------
# Live eval runs write here. Recorded fixtures and the committed run boards
# (evals/scoreboards/, ADR 0017) live elsewhere under evals/ and are tracked.
evals/runs/
# `make eval-live` writes each run's scoreboard and traces here, and the effort comparison's
# recordings (kept only if medium effort is adopted) in fixtures-effort/, and a run of another
# model (`MODEL=`, for comparing models on one commit) in fixtures-sonnet/.
evals/assistant/runs/
evals/assistant/fixtures-effort/
evals/assistant/fixtures-sonnet/
# A save writes a dotted temporary file beside a fixture first; a crash could leave it.
evals/assistant/fixtures*/.*.tmp

# --- OS and editors --------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.local
*.log
