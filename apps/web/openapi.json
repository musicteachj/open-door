{
  "openapi": "3.1.0",
  "info": {
    "title": "Open Door API",
    "version": "0.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Report whether the API and its database are up",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sandboxes": {
      "post": {
        "tags": [
          "sandboxes"
        ],
        "summary": "Start a new sandbox company and sign in to it as one of its personas",
        "operationId": "createSandbox",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/NewSandboxRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SandboxCreated"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "The signed-in person's own card, and when their sandbox expires",
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session/persona": {
      "put": {
        "tags": [
          "session"
        ],
        "summary": "Sign in as another persona in the same sandbox, with new session and CSRF tokens",
        "operationId": "switchPersona",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonaChoice"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session": {
      "delete": {
        "tags": [
          "session"
        ],
        "summary": "Sign out: end the session and clear its cookies",
        "operationId": "endSession",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/people": {
      "get": {
        "tags": [
          "people"
        ],
        "summary": "The company directory, a page at a time",
        "operationId": "listPeople",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "name": "locationId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Locationid"
            }
          },
          {
            "name": "departmentId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Departmentid"
            }
          },
          {
            "name": "team",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "const": "mine",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Team"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectoryPage"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/people/facets": {
      "get": {
        "tags": [
          "people"
        ],
        "summary": "The directory's counts: the header's, and each filter option's",
        "operationId": "getDirectoryFacets",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "name": "locationId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Locationid"
            }
          },
          {
            "name": "departmentId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Departmentid"
            }
          },
          {
            "name": "team",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "const": "mine",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Team"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectoryFacets"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/people/{person_id}": {
      "get": {
        "tags": [
          "people"
        ],
        "summary": "One person's directory card",
        "operationId": "getPerson",
        "parameters": [
          {
            "name": "person_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Person Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectoryCard"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/people/{person_id}/private": {
      "get": {
        "tags": [
          "people"
        ],
        "summary": "One person's private details, for that person and for HR. Each read is audited.",
        "operationId": "getPersonPrivate",
        "parameters": [
          {
            "name": "person_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Person Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrivateDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DepartmentCount": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "count"
        ],
        "title": "DepartmentCount"
      },
      "DepartmentRef": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "DepartmentRef"
      },
      "DirectoryCard": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "givenName": {
            "type": "string",
            "title": "Givenname"
          },
          "familyName": {
            "type": "string",
            "title": "Familyname"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "department": {
            "$ref": "#/components/schemas/DepartmentRef"
          },
          "location": {
            "$ref": "#/components/schemas/LocationRef"
          },
          "manager": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PersonRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "workEmail": {
            "type": "string",
            "title": "Workemail"
          }
        },
        "type": "object",
        "required": [
          "id",
          "givenName",
          "familyName",
          "title",
          "department",
          "location",
          "manager",
          "workEmail"
        ],
        "title": "DirectoryCard"
      },
      "DirectoryFacets": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "matching": {
            "type": "integer",
            "title": "Matching"
          },
          "locations": {
            "items": {
              "$ref": "#/components/schemas/LocationCount"
            },
            "type": "array",
            "title": "Locations"
          },
          "departments": {
            "items": {
              "$ref": "#/components/schemas/DepartmentCount"
            },
            "type": "array",
            "title": "Departments"
          },
          "myTeam": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Myteam"
          }
        },
        "type": "object",
        "required": [
          "total",
          "matching",
          "locations",
          "departments",
          "myTeam"
        ],
        "title": "DirectoryFacets",
        "description": "The counts behind the directory's header and filter menus.\n\nAn option's count is how many people the list would show if that option were chosen, with\nevery other active filter kept. Every location and department is listed, even at zero."
      },
      "DirectoryPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/DirectoryCard"
            },
            "type": "array",
            "title": "Items"
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "title": "DirectoryPage"
      },
      "FieldError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError",
        "description": "One failed field on a 422: where it was, what was wrong, and the error's kind."
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "version"
        ],
        "title": "HealthResponse"
      },
      "LocationCount": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "state",
          "count"
        ],
        "title": "LocationCount"
      },
      "LocationRef": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "state",
          "timezone"
        ],
        "title": "LocationRef"
      },
      "Me": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "givenName": {
            "type": "string",
            "title": "Givenname"
          },
          "familyName": {
            "type": "string",
            "title": "Familyname"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "department": {
            "$ref": "#/components/schemas/DepartmentRef"
          },
          "location": {
            "$ref": "#/components/schemas/LocationRef"
          },
          "manager": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PersonRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "workEmail": {
            "type": "string",
            "title": "Workemail"
          },
          "employmentType": {
            "type": "string",
            "enum": [
              "salaried",
              "hourly"
            ],
            "title": "Employmenttype"
          },
          "isManager": {
            "type": "boolean",
            "title": "Ismanager"
          },
          "isHrAdmin": {
            "type": "boolean",
            "title": "Ishradmin"
          },
          "personaKey": {
            "$ref": "#/components/schemas/PersonaKey"
          },
          "tenantExpiresAt": {
            "type": "string",
            "format": "date-time",
            "title": "Tenantexpiresat"
          }
        },
        "type": "object",
        "required": [
          "id",
          "givenName",
          "familyName",
          "title",
          "department",
          "location",
          "manager",
          "workEmail",
          "employmentType",
          "isManager",
          "isHrAdmin",
          "personaKey",
          "tenantExpiresAt"
        ],
        "title": "Me",
        "description": "The signed-in person's own card, with the fields only they see."
      },
      "NewSandboxRequest": {
        "properties": {
          "persona": {
            "$ref": "#/components/schemas/PersonaKey",
            "default": "priya"
          }
        },
        "type": "object",
        "title": "NewSandboxRequest"
      },
      "PersonRef": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "givenName": {
            "type": "string",
            "title": "Givenname"
          },
          "familyName": {
            "type": "string",
            "title": "Familyname"
          }
        },
        "type": "object",
        "required": [
          "id",
          "givenName",
          "familyName"
        ],
        "title": "PersonRef"
      },
      "PersonaChoice": {
        "properties": {
          "persona": {
            "$ref": "#/components/schemas/PersonaKey"
          }
        },
        "type": "object",
        "required": [
          "persona"
        ],
        "title": "PersonaChoice"
      },
      "PersonaKey": {
        "type": "string",
        "enum": [
          "priya",
          "mateo",
          "marcus",
          "dana"
        ]
      },
      "PrivateDetails": {
        "properties": {
          "personalEmail": {
            "type": "string",
            "title": "Personalemail"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "homeAddress": {
            "type": "string",
            "title": "Homeaddress"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "title": "Dateofbirth"
          }
        },
        "type": "object",
        "required": [
          "personalEmail",
          "phone",
          "homeAddress",
          "dateOfBirth"
        ],
        "title": "PrivateDetails"
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "instance": {
            "type": "string",
            "title": "Instance"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "requestId": {
            "anyOf": [
